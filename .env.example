# AI-News Application Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV=development
PORT=3032

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGO_URI=mongodb://localhost:27017/ai_news
MONGODB_URI=mongodb://localhost:27017/ai_news

# ==========================================
# API CONFIGURATION
# ==========================================
API_BASE_URL=http://localhost:3032
BACKEND_URL=http://localhost:3032
FRONTEND_URL=http://localhost:3000

# ==========================================
# EXTERNAL API KEYS (Required for full functionality)
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# ==========================================
# NEWS API SOURCES (Optional)
# ==========================================
NEWS_API_KEY=your-news-api-key-here
NEWS_API_ORG_KEY=your-news-api-org-key-here

# ==========================================
# VERIFICATION TOKENS (For CI/CD deployment)
# ==========================================
VERCEL_TOKEN=vercel_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VERCEL_ORG_ID=team_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
VERCEL_FRONTEND_PROJECT_ID=prj_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
VERCEL_BACKEND_PROJECT_ID=prj_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
SONAR_TOKEN=sonar_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==========================================
# SECURITY SETTINGS (Change in production!)
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-key-change-this-in-production

# ==========================================
# CACHE & PERFORMANCE (Optional)
# ==========================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ==========================================
# PRODUCTION URLS (Update with your actual Vercel URLs)
# ==========================================
PROD_FRONTEND_URL=https://your-frontend-app.vercel.app
PROD_BACKEND_URL=https://your-backend-app.vercel.app
PROD_API_URL=https://your-backend-app.vercel.app
